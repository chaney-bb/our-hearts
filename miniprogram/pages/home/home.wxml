<view class="page">

  <view class="gate-wrap" wx:if="{{needRegister}}">
    <view class="gate-card">
      <view class="gate-emoji">📝</view>
      <view class="gate-title">先互相认识一下</view>
      <view class="gate-desc">填一下你们的基本信息（只有你们两个人能看到），之后就能一起打卡了</view>
      <view class="btn gate-btn" bindtap="gotoRegister">去登记</view>
    </view>
  </view>

  <view class="loading" wx:if="{{!ready && !error && !needRegister}}">正在唤醒我们的小窝…</view>

  <view class="err-wrap" wx:if="{{error}}">
    <view class="err-card">
      <view class="err-icon">☁️</view>
      <view class="err-title">连接没成功</view>
      <view class="err-msg">{{error}}</view>
      <view class="err-raw" wx:if="{{errorRaw}}">技术信息：{{errorRaw}}</view>
      <view class="err-actions">
        <view class="btn-ghost" bindtap="retry">重试</view>
        <view class="btn-ghost primary" bindtap="useLocal">先用本地模式</view>
      </view>
    </view>
  </view>

  <block wx:if="{{ready}}">

    <!-- 顶部：在一起多少天 + 两个人的爱心 -->
    <view class="hero" style="padding-top:{{navTop}}px">
      <view class="blob blob-a"></view>
      <view class="blob blob-b"></view>

      <view class="hero-top">
        <view class="days-chip">在一起第 {{daysTogether}} 天</view>
        <view class="avatars">
          <view class="av">{{me.avatarEmoji}}</view>
          <view class="av av-2">{{partner ? partner.avatarEmoji : '💫'}}</view>
        </view>
      </view>

      <view class="hearts-row">
        <text class="heart-ico">❤️</text>
        <text class="heart-num">{{hearts}}</text>
        <text class="heart-unit">我的爱心</text>
      </view>

      <view class="partner-hearts" wx:if="{{bound}}">
        <text class="ph-emoji">{{partner.avatarEmoji}}</text>
        <text class="ph-name">{{partner.displayName}}</text>
        <text class="ph-num">💗 {{partnerHearts}}</text>
      </view>
      <view class="partner-hearts" wx:else>
        <text class="ph-name">还没配对，爱心先存着</text>
      </view>
    </view>

    <view class="body">

      <!-- 还没配对：邀请码卡片 -->
      <view class="bind-card" wx:if="{{!bound}}">
        <view class="bind-title">还没和 TA 配对</view>
        <view class="bind-desc">把邀请码发给 TA，TA 在下面「输入 TA 的邀请码」里填一下，两个人就绑上了</view>
        <view class="code-row">
          <text class="code">{{inviteCode}}</text>
          <view class="btn-ghost" bindtap="copyCode">复制</view>
        </view>
        <view class="btn-ghost primary bind-join" bindtap="joinByCode">输入 TA 的邀请码</view>
      </view>

      <!-- 功能宫格：两列，内容来自 core/modules.js -->
      <view class="section-head">
        <text class="section-title">我们的小功能</text>
        <text class="section-sub">加功能只改注册表</text>
      </view>

      <view class="grid">
        <view
          class="grid-item {{item.enabled ? '' : 'is-off'}}"
          wx:for="{{grid}}"
          wx:key="key"
          data-item="{{item}}"
          bindtap="openModule"
        >
          <view class="gi-emoji {{item.color}}">{{item.emoji}}</view>
          <view class="gi-name">{{item.name}}</view>
          <view class="gi-desc">{{item.desc}}</view>
          <view class="gi-sub" wx:if="{{item.sub}}">{{item.sub}}</view>
        </view>
      </view>

      <view class="mock-tip" wx:if="{{mode === 'mock'}}">
        本地预览模式：数据只存在这台手机上，不会同步。配置云开发后才是真的情侣共享。
      </view>

      <view class="safe-bottom"></view>
    </view>

  </block>
</view>
