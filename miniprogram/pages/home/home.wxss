/* ================= 顶部渐变卡 ================= */
.hero {
  position: relative;
  overflow: hidden;
  padding: 0 40rpx 44rpx;
  border-radius: 0 0 48rpx 48rpx;
  background: linear-gradient(135deg, #FFA1AE 0%, #FF7189 52%, #FF5C77 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(255, 92, 119, 0.28);
}

.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  pointer-events: none;
}

.blob-a {
  width: 320rpx;
  height: 320rpx;
  top: -140rpx;
  right: -100rpx;
}

.blob-b {
  width: 220rpx;
  height: 220rpx;
  bottom: -120rpx;
  left: -60rpx;
  background: rgba(255, 255, 255, 0.1);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.days-chip {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
}

.avatars {
  display: flex;
  align-items: center;
}

.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border: 3rpx solid #FFFFFF;
}

.av-2 {
  margin-left: -18rpx;
}

.hearts-row {
  display: flex;
  align-items: baseline;
  margin-top: 48rpx;
  position: relative;
  z-index: 1;
}

.heart-ico {
  font-size: 44rpx;
  margin-right: 12rpx;
}

.heart-num {
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -3rpx;
}

.heart-unit {
  font-size: 26rpx;
  margin-left: 12rpx;
  opacity: 0.85;
}

.partner-hearts {
  display: inline-flex;
  align-items: center;
  margin-top: 20rpx;
  position: relative;
  z-index: 1;
  font-size: 24rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 999rpx;
  padding: 10rpx 22rpx 10rpx 14rpx;
}

.ph-emoji {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.ph-name {
  margin-right: 12rpx;
  opacity: 0.9;
}

.ph-num {
  font-weight: 600;
}

/* ================= 内容区 ================= */
.body {
  padding: 8rpx 32rpx 0;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 34rpx 8rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-sub {
  font-size: 22rpx;
  color: #B9A5A0;
}

/* ================= 两列宫格 ================= */
.grid {
  display: flex;
  flex-wrap: wrap;
}

.grid-item {
  width: calc(50% - 11rpx);
  margin: 0 22rpx 22rpx 0;
  padding: 30rpx 26rpx;
  background: #FFFFFF;
  border-radius: 30rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
  position: relative;
  overflow: hidden;
  transition: transform 0.15s ease;
}

.grid-item:nth-child(2n) {
  margin-right: 0;
}

.grid-item:active {
  transform: scale(0.975);
}

.grid-item.is-off {
  opacity: 0.62;
}

.gi-emoji {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: #FFF0F3;
  margin-bottom: 20rpx;
}

.gi-emoji.pink {
  background: #FFF0F3;
}

.gi-emoji.blue {
  background: #EDF3FF;
}

.gi-emoji.orange {
  background: #FFF3E3;
}

.gi-name {
  font-size: 30rpx;
  font-weight: 600;
}

.gi-desc {
  font-size: 22rpx;
  color: #A08B87;
  margin-top: 6rpx;
}

.gi-sub {
  margin-top: 14rpx;
  font-size: 21rpx;
  color: #FF6B81;
  font-weight: 500;
}

.grid-item.is-off .gi-sub {
  color: #B9A5A0;
  font-weight: 400;
}

/* ================= 配对卡 ================= */
.bind-card {
  margin-top: 26rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF4F6 100%);
  border: 3rpx dashed #FFD3DA;
}

.bind-title {
  font-size: 30rpx;
  font-weight: 600;
}

.bind-desc {
  font-size: 23rpx;
  color: #A08B87;
  margin-top: 10rpx;
  line-height: 1.6;
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #FF5C77;
  font-variant-numeric: tabular-nums;
}

.bind-join {
  margin-top: 20rpx;
  height: 80rpx;
  font-size: 28rpx;
}

.mock-tip {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FDF3EF;
  font-size: 22rpx;
  color: #B08A7E;
  line-height: 1.6;
}

/* ================= 加载 / 错误 / 引导 ================= */
.loading {
  padding-top: 200rpx;
  text-align: center;
  font-size: 26rpx;
  color: #C9B8B4;
}

.err-wrap {
  padding: 160rpx 36rpx 0;
}

.err-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 129, 0.12);
}

.err-icon {
  font-size: 64rpx;
  line-height: 1;
}

.err-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.err-msg {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6B5754;
  line-height: 1.65;
}

.err-raw {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FDF3EF;
  font-size: 21rpx;
  color: #B08A7E;
  word-break: break-all;
  line-height: 1.6;
}

.err-actions {
  display: flex;
  margin-top: 28rpx;
}

.err-actions .btn-ghost {
  margin-right: 18rpx;
}

.gate-wrap {
  padding: 180rpx 44rpx 0;
}

.gate-card {
  background: #FFFFFF;
  border-radius: 36rpx;
  padding: 56rpx 44rpx;
  text-align: center;
  box-shadow: 0 16rpx 50rpx rgba(255, 107, 129, 0.14);
}

.gate-emoji {
  font-size: 84rpx;
  line-height: 1;
}

.gate-title {
  font-size: 36rpx;
  font-weight: 700;
  margin-top: 28rpx;
}

.gate-desc {
  font-size: 25rpx;
  color: #A08B87;
  line-height: 1.7;
  margin-top: 16rpx;
}

.gate-btn {
  margin-top: 40rpx;
  height: 88rpx;
}
