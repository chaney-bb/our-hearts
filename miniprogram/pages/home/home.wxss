/* ================= 顶部渐变卡 ================= */
.hero {
  position: relative;
  overflow: hidden;
  padding: 0 40rpx 44rpx;
  border-radius: 0 0 48rpx 48rpx;
  background: linear-gradient(135deg, #FFA1AE 0%, #FF7189 52%, #FF5C77 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 40rpx rgba(255, 92, 119, 0.28);
}

/* 背景装饰圆，纯装饰，不影响点击 */
.blob {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.14);
  pointer-events: none;
}

.blob-a {
  width: 320rpx;
  height: 320rpx;
  top: -140rpx;
  right: -100rpx;
}

.blob-b {
  width: 220rpx;
  height: 220rpx;
  bottom: -120rpx;
  left: -60rpx;
  background: rgba(255, 255, 255, 0.1);
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
  z-index: 1;
}

.days-chip {
  font-size: 24rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  letter-spacing: 0.5rpx;
}

.avatars {
  display: flex;
  align-items: center;
}

.av {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  border: 3rpx solid #FFFFFF;
}

.av-2 {
  margin-left: -18rpx;
}

.hearts-row {
  display: flex;
  align-items: baseline;
  margin-top: 48rpx;
  position: relative;
  z-index: 1;
}

.heart-ico {
  font-size: 44rpx;
  margin-right: 12rpx;
}

.heart-num {
  font-size: 108rpx;
  font-weight: 700;
  line-height: 1;
  letter-spacing: -3rpx;
}

.heart-unit {
  font-size: 26rpx;
  margin-left: 12rpx;
  opacity: 0.85;
}

.streak-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 28rpx;
  position: relative;
  z-index: 1;
}

.streak-chip {
  font-size: 25rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
}

.clock {
  font-size: 24rpx;
  opacity: 0.8;
  font-variant-numeric: tabular-nums;
}

/* ================= 内容区 ================= */
.body {
  padding: 8rpx 32rpx 0;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 8rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-sub {
  font-size: 24rpx;
  color: #B9A5A0;
}

/* ================= 打卡卡片 ================= */
.check-card {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.check-card.is-open {
  border-color: #FFDCE2;
  box-shadow: 0 12rpx 34rpx rgba(255, 107, 129, 0.16);
}

.check-card.is-done {
  background: #FFFDFC;
  border-color: #EAF7F2;
}

.check-card:active {
  transform: scale(0.985);
}

.emoji-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.emoji-wrap.sleep {
  background: #EEEBFF;
}

.emoji-wrap.wake {
  background: #FFF3E0;
}

.card-main {
  flex: 1;
  min-width: 0;
  padding: 0 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card-meta {
  font-size: 23rpx;
  color: #A08B87;
  margin-top: 4rpx;
}

.card-hint {
  font-size: 23rpx;
  margin-top: 8rpx;
  color: #A08B87;
}

.card-hint.open {
  color: #FF6B81;
  font-weight: 600;
}

.card-hint.done {
  color: #2FAE8B;
}

.card-hint.expired {
  color: #C9B8B4;
}

/* ================= 配对卡 ================= */
.bind-card {
  margin-top: 8rpx;
  margin-bottom: 22rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF4F6 100%);
  border: 3rpx dashed #FFD3DA;
}

.bind-title {
  font-size: 30rpx;
  font-weight: 600;
}

.bind-desc {
  font-size: 23rpx;
  color: #A08B87;
  margin-top: 10rpx;
  line-height: 1.6;
}

.code-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.code {
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #FF5C77;
  font-variant-numeric: tabular-nums;
}

.bind-join {
  margin-top: 20rpx;
  height: 80rpx;
  font-size: 28rpx;
}

.partner-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.partner-av {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #FFF0F3;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.partner-main {
  flex: 1;
  padding: 0 20rpx;
}

.partner-name {
  font-size: 30rpx;
  font-weight: 600;
}

.partner-sub {
  font-size: 23rpx;
  color: #A08B87;
  margin-top: 4rpx;
}

.partner-tag {
  font-size: 22rpx;
  color: #2FAE8B;
  background: #EAF7F2;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
}

/* ================= 最近 7 天 ================= */
.week-card {
  padding: 28rpx;
  margin-bottom: 22rpx;
}

.week-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.week-title {
  font-size: 28rpx;
  font-weight: 600;
}

.week-dots {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.week-dot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F7EFED;
  color: #C9B8B4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.week-dot.on .dot-mark {
  background: #FFE8EC;
  font-size: 24rpx;
}

.dot-day {
  font-size: 20rpx;
  color: #B9A5A0;
  margin-top: 10rpx;
}

/* ================= 规则说明 ================= */
.rules-card {
  padding: 30rpx 32rpx;
}

.rules-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.rule-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  color: #6B5754;
  padding: 10rpx 0;
}

.plus {
  font-weight: 700;
  color: #FF6B81;
}

.rule-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B9A5A0;
  line-height: 1.6;
}

.mock-tip {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FDF3EF;
  font-size: 22rpx;
  color: #B08A7E;
  line-height: 1.6;
}

/* ================= 爱心飘动 ================= */
.float-heart {
  position: fixed;
  left: 50%;
  top: 34%;
  transform: translateX(-50%);
  z-index: 99;
  text-align: center;
  pointer-events: none;
  animation: floatUp 1.8s ease-out forwards;
}

.float-num {
  font-size: 60rpx;
  font-weight: 700;
  color: #FF5C77;
  text-shadow: 0 4rpx 16rpx rgba(255, 92, 119, 0.35);
}

.float-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #FF8FA3;
  background: rgba(255, 255, 255, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

@keyframes floatUp {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(20rpx) scale(0.8);
  }
  25% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1.05);
  }
  70% {
    opacity: 1;
    transform: translateX(-50%) translateY(-60rpx) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(-140rpx) scale(0.95);
  }
}

/* ================= 加载态 / 错误态 ================= */
.loading {
  padding-top: 200rpx;
  text-align: center;
  font-size: 26rpx;
  color: #C9B8B4;
}

.err-wrap {
  padding: 160rpx 36rpx 0;
}

.err-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 129, 0.12);
}

.err-icon {
  font-size: 64rpx;
  line-height: 1;
}

.err-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.err-msg {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6B5754;
  line-height: 1.65;
}

.err-raw {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FDF3EF;
  font-size: 21rpx;
  color: #B08A7E;
  word-break: break-all;
  line-height: 1.6;
}

.err-actions {
  display: flex;
  margin-top: 28rpx;
}

.err-actions .btn-ghost {
  margin-right: 18rpx;
}

.err-note {
  margin-top: 26rpx;
  font-size: 22rpx;
  color: #B9A5A0;
  line-height: 1.7;
}
