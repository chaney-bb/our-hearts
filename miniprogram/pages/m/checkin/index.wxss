.page {
  padding: 0 32rpx;
  background: #FFF7F3;
  min-height: 100vh;
}

/* 连续天数条 */
.stat-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 8rpx;
  padding: 30rpx 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFA1AE 0%, #FF7189 60%, #FF5C77 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 34rpx rgba(255, 92, 119, 0.25);
}

.ss-main {
  display: flex;
  align-items: baseline;
}

.ss-num {
  font-size: 44rpx;
  font-weight: 700;
}

.ss-label {
  margin-left: 14rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.ss-time {
  font-size: 24rpx;
  opacity: 0.85;
  font-variant-numeric: tabular-nums;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 8rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-sub {
  font-size: 24rpx;
  color: #B9A5A0;
}

/* 打卡卡片（和首页旧版保持一致） */
.check-card {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.check-card.is-open {
  border-color: #FFDCE2;
  box-shadow: 0 12rpx 34rpx rgba(255, 107, 129, 0.16);
}

.check-card.is-done {
  background: #FFFDFC;
  border-color: #EAF7F2;
}

.check-card:active {
  transform: scale(0.985);
}

.emoji-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.emoji-wrap.sleep {
  background: #EEEBFF;
}

.emoji-wrap.wake {
  background: #FFF3E0;
}

.card-main {
  flex: 1;
  min-width: 0;
  padding: 0 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card-meta {
  font-size: 23rpx;
  color: #A08B87;
  margin-top: 4rpx;
}

.card-hint {
  font-size: 23rpx;
  margin-top: 8rpx;
  color: #A08B87;
}

.card-hint.open {
  color: #FF6B81;
  font-weight: 600;
}

.card-hint.done {
  color: #2FAE8B;
}

.card-hint.expired {
  color: #C9B8B4;
}

/* 最近 7 天 */
.week-card {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
  margin-bottom: 22rpx;
}

.week-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.week-title {
  font-size: 28rpx;
  font-weight: 600;
}

.tip {
  font-size: 22rpx;
  color: #A08B87;
}

.week-dots {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.week-dot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F7EFED;
  color: #C9B8B4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.week-dot.on .dot-mark {
  background: #FFE8EC;
  font-size: 24rpx;
}

.dot-day {
  font-size: 20rpx;
  color: #B9A5A0;
  margin-top: 10rpx;
}

/* 规则说明 */
.rules-card {
  padding: 30rpx 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
}

.rules-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.rule-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  color: #6B5754;
  padding: 10rpx 0;
}

.plus {
  font-weight: 700;
  color: #FF6B81;
}

.rule-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B9A5A0;
  line-height: 1.6;
}

/* 提示条 */
.stale-banner {
  display: block;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #FFF6E8;
  border: 2rpx solid #FFE0B2;
}

.stale-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #C9821B;
  margin-bottom: 8rpx;
}

.stale-text {
  display: block;
  font-size: 22rpx;
  color: #96754A;
  line-height: 1.65;
}

/* 加载 / 错误 */
.loading {
  padding-top: 200rpx;
  text-align: center;
  font-size: 26rpx;
  color: #C9B8B4;
}

.err-wrap {
  padding-top: 120rpx;
}

.err-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 129, 0.12);
}

.err-icon {
  font-size: 64rpx;
  line-height: 1;
}

.err-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.err-msg {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6B5754;
  line-height: 1.65;
}

.err-raw {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FDF3EF;
  font-size: 21rpx;
  color: #B08A7E;
  word-break: break-all;
}

.err-actions {
  display: flex;
  margin-top: 28rpx;
}

/* 爱心飘动 */
.float-heart {
  position: fixed;
  left: 50%;
  top: 34%;
  transform: translateX(-50%);
  z-index: 99;
  text-align: center;
  pointer-events: none;
  animation: floatUp 1.8s ease-out forwards;
}

.float-num {
  font-size: 60rpx;
  font-weight: 700;
  color: #FF5C77;
  text-shadow: 0 4rpx 16rpx rgba(255, 92, 119, 0.35);
}

.float-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #FF8FA3;
  background: rgba(255, 255, 255, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

@keyframes floatUp {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(20rpx) scale(0.8);
  }
  25% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1.05);
  }
  70% {
    opacity: 1;
    transform: translateX(-50%) translateY(-60rpx) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(-140rpx) scale(0.95);
  }
}
