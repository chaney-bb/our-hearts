.page {
  padding: 0 32rpx;
  background: #FFF7F3;
  min-height: 100vh;
}

/* 连续天数条 */
.stat-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 0 8rpx;
  padding: 30rpx 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(135deg, #FFA1AE 0%, #FF7189 60%, #FF5C77 100%);
  color: #FFFFFF;
  box-shadow: 0 12rpx 34rpx rgba(255, 92, 119, 0.25);
}

.ss-main {
  display: flex;
  align-items: baseline;
}

.ss-num {
  font-size: 44rpx;
  font-weight: 700;
}

.ss-label {
  margin-left: 14rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

.ss-time {
  font-size: 24rpx;
  opacity: 0.85;
  font-variant-numeric: tabular-nums;
}

/* 本月全勤进度 */
.month-strip {
  display: flex;
  align-items: center;
  margin: 16rpx 0 4rpx;
  padding: 22rpx 28rpx;
  background: #FFFFFF;
  border-radius: 26rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
}

.ms-label {
  font-size: 24rpx;
  color: #A08B87;
}

.ms-val {
  margin-left: 14rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B81;
}

.ms-tag {
  margin-left: auto;
  font-size: 21rpx;
  color: #2FAE8B;
  background: #EAF7F2;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.more {
  margin-left: 16rpx;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #FFF0F3;
  color: #FF6B81;
  font-size: 34rpx;
  line-height: 66rpx;
  text-align: center;
  font-weight: 700;
}

/* ================= 右上角菜单（自绘底部弹层） ================= */
.sheet-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(58, 42, 40, 0.42);
  z-index: 200;
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 201;
  background: #FFF7F3;
  border-radius: 32rpx 32rpx 0 0;
  padding: 20rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 40rpx rgba(58, 42, 40, 0.16);
  animation: sheetUp 0.18s ease-out;
}

@keyframes sheetUp {
  from {
    transform: translateY(40rpx);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet-title {
  text-align: center;
  font-size: 22rpx;
  color: #B9A5A0;
  padding: 12rpx 0 18rpx;
}

.sheet-item {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 26rpx 24rpx;
  margin-bottom: 16rpx;
}

.sheet-item:active {
  background: #FFF0F3;
}

.sheet-emoji {
  font-size: 36rpx;
  margin-right: 18rpx;
}

.sheet-main {
  flex: 1;
}

.sheet-name {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #3A2A28;
}

.sheet-desc {
  display: block;
  font-size: 21rpx;
  color: #A08B87;
  margin-top: 4rpx;
}

.sheet-cancel {
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: 28rpx;
  color: #6B5754;
  background: #FFFFFF;
  border-radius: 24rpx;
}

/* 缺卡提示 */
.miss-card {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  padding: 24rpx 26rpx;
  background: #FFF6E8;
  border: 2rpx solid #FFE0B2;
  border-radius: 24rpx;
}

.miss-main {
  flex: 1;
  min-width: 0;
}

.miss-title {
  display: block;
  font-size: 25rpx;
  font-weight: 600;
  color: #B4771B;
}

.miss-sub {
  display: block;
  font-size: 21rpx;
  color: #96754A;
  margin-top: 4rpx;
}

.miss-btn {
  font-size: 22rpx;
  color: #FFFFFF;
  background: linear-gradient(135deg, #FFB05C, #FF8A3D);
  padding: 12rpx 22rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.miss-btn.is-off {
  background: #EDE3DD;
  color: #B9A5A0;
}

/* 当月日历 */
.cal-card {
  padding: 26rpx 20rpx 20rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
  margin-bottom: 22rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 18rpx;
}

.cal-title {
  font-size: 27rpx;
  font-weight: 600;
}

.cal-legend {
  display: flex;
  align-items: center;
}

.lg {
  display: flex;
  align-items: center;
  margin-left: 20rpx;
  font-size: 20rpx;
  color: #A08B87;
}

.lg .bar {
  margin-right: 8rpx;
}

.cal-week {
  display: flex;
  padding-bottom: 8rpx;
}

.cal-week-cell {
  width: 14.2857%;
  text-align: center;
  font-size: 20rpx;
  color: #B9A5A0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  height: 86rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cal-day {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 23rpx;
  color: #4A3A38;
}

.cal-day.is-today {
  border: 3rpx solid #FF6B81;
  line-height: 36rpx;
  color: #FF5C77;
  font-weight: 700;
}

.bars {
  margin-top: 4rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.bar {
  width: 22rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: #F2E6E3;
  margin: 2rpx 0;
}

.bar.me.lv1 {
  background: rgba(255, 107, 129, 0.34);
}

.bar.me.lv2 {
  background: rgba(255, 107, 129, 0.6);
}

.bar.me.lv3 {
  background: #FF6B81;
}

.bar.ta.lv1 {
  background: rgba(108, 140, 255, 0.34);
}

.bar.ta.lv2 {
  background: rgba(108, 140, 255, 0.6);
}

.bar.ta.lv3 {
  background: #6C8CFF;
}

.cal-note {
  margin-top: 14rpx;
  padding-top: 14rpx;
  border-top: 2rpx solid #FDF1EE;
  font-size: 20rpx;
  color: #B9A5A0;
  line-height: 1.6;
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 32rpx 8rpx 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.section-sub {
  font-size: 24rpx;
  color: #B9A5A0;
}

/* 打卡卡片（和首页旧版保持一致） */
.check-card {
  display: flex;
  align-items: center;
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  border: 3rpx solid transparent;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.check-card.is-open {
  border-color: #FFDCE2;
  box-shadow: 0 12rpx 34rpx rgba(255, 107, 129, 0.16);
}

.check-card.is-done {
  background: #FFFDFC;
  border-color: #EAF7F2;
}

.check-card:active {
  transform: scale(0.985);
}

.emoji-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.emoji-wrap.sleep {
  background: #EEEBFF;
}

.emoji-wrap.wake {
  background: #FFF3E0;
}

.card-main {
  flex: 1;
  min-width: 0;
  padding: 0 24rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.3;
}

.card-meta {
  font-size: 23rpx;
  color: #A08B87;
  margin-top: 4rpx;
}

.card-hint {
  font-size: 23rpx;
  margin-top: 8rpx;
  color: #A08B87;
}

.card-hint.open {
  color: #FF6B81;
  font-weight: 600;
}

.card-hint.done {
  color: #2FAE8B;
}

.card-hint.expired {
  color: #C9B8B4;
}

/* 最近 7 天 */
.week-card {
  padding: 28rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
  margin-bottom: 22rpx;
}

.week-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.week-title {
  font-size: 28rpx;
  font-weight: 600;
}

.tip {
  font-size: 22rpx;
  color: #A08B87;
}

.week-dots {
  display: flex;
  justify-content: space-between;
  margin-top: 22rpx;
}

.week-dot {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.dot-mark {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F7EFED;
  color: #C9B8B4;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
}

.week-dot.on .dot-mark {
  background: #FFE8EC;
  font-size: 24rpx;
}

.dot-day {
  font-size: 20rpx;
  color: #B9A5A0;
  margin-top: 10rpx;
}

/* 规则说明 */
.rules-card {
  padding: 30rpx 32rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
}

.rules-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

.rule-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 25rpx;
  color: #6B5754;
  padding: 10rpx 0;
}

.plus {
  font-weight: 700;
  color: #FF6B81;
}

.rule-note {
  margin-top: 16rpx;
  font-size: 22rpx;
  color: #B9A5A0;
  line-height: 1.6;
}

/* 提示条 */
.stale-banner {
  display: block;
  margin-top: 22rpx;
  padding: 24rpx 26rpx;
  border-radius: 24rpx;
  background: #FFF6E8;
  border: 2rpx solid #FFE0B2;
}

.stale-title {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  color: #C9821B;
  margin-bottom: 8rpx;
}

.stale-text {
  display: block;
  font-size: 22rpx;
  color: #96754A;
  line-height: 1.65;
}

/* 加载 / 错误 */
.loading {
  padding-top: 200rpx;
  text-align: center;
  font-size: 26rpx;
  color: #C9B8B4;
}

.err-wrap {
  padding-top: 120rpx;
}

.err-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 36rpx;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 129, 0.12);
}

.err-icon {
  font-size: 64rpx;
  line-height: 1;
}

.err-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-top: 20rpx;
}

.err-msg {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #6B5754;
  line-height: 1.65;
}

.err-raw {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: #FDF3EF;
  font-size: 21rpx;
  color: #B08A7E;
  word-break: break-all;
}

.err-actions {
  display: flex;
  margin-top: 28rpx;
}

/* 爱心飘动 */
.float-heart {
  position: fixed;
  left: 50%;
  top: 34%;
  transform: translateX(-50%);
  z-index: 99;
  text-align: center;
  pointer-events: none;
  animation: floatUp 1.8s ease-out forwards;
}

.float-num {
  font-size: 60rpx;
  font-weight: 700;
  color: #FF5C77;
  text-shadow: 0 4rpx 16rpx rgba(255, 92, 119, 0.35);
}

.float-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #FF8FA3;
  background: rgba(255, 255, 255, 0.9);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  white-space: nowrap;
}

@keyframes floatUp {
  0% {
    opacity: 0;
    transform: translateX(-50%) translateY(20rpx) scale(0.8);
  }
  25% {
    opacity: 1;
    transform: translateX(-50%) translateY(0) scale(1.05);
  }
  70% {
    opacity: 1;
    transform: translateX(-50%) translateY(-60rpx) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateX(-50%) translateY(-140rpx) scale(0.95);
  }
}
