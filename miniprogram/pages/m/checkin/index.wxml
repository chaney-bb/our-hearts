<view class="page">

  <view class="loading" wx:if="{{!ready && !error}}">正在加载…</view>

  <view class="err-wrap" wx:if="{{error}}">
    <view class="err-card">
      <view class="err-icon">☁️</view>
      <view class="err-title">打不开打卡</view>
      <view class="err-msg">{{error}}</view>
      <view class="err-raw" wx:if="{{errorRaw}}">技术信息：{{errorRaw}}</view>
      <view class="err-actions">
        <view class="btn-ghost" bindtap="retry">重试</view>
      </view>
    </view>
  </view>

  <block wx:if="{{ready}}">

    <view class="stat-strip">
      <view class="ss-main">
        <text class="ss-num">🔥 {{streak}}</text>
        <text class="ss-label">连续全勤天数</text>
      </view>
      <view class="ss-time">{{clock}}</view>
    </view>

    <view class="month-strip">
      <text class="ms-label">本月全勤</text>
      <text class="ms-val">{{monthText}}</text>
      <text class="ms-tag" wx:if="{{monthReached}}">已达标 🎉</text>
      <view class="more" bindtap="openMenu">⋯</view>    </view>

    <!-- 缺卡提示 + 申诉入口 -->
    <view class="miss-card" wx:for="{{misses}}" wx:key="dayKey" wx:for-item="m">
      <view class="miss-main">
        <text class="miss-title">{{m.emoji}} {{m.label}}漏打 · {{m.dayKey}}</text>
        <text class="miss-sub">已扣 {{m.penalty}} 爱心</text>
      </view>
      <view class="miss-btn {{m.appealable ? '' : 'is-off'}}" data-day="{{m.dayKey}}" data-type="{{m.type}}" bindtap="onAppeal">
        {{m.appealable ? '说明一下' : '申诉已过期'}}
      </view>
    </view>

    <view class="section-head">
      <text class="section-title">这一晚的打卡</text>
      <text class="section-sub">{{dayLabel}}</text>
    </view>

    <view
      wx:for="{{items}}"
      wx:key="key"
      class="check-card {{item.canCheck ? 'is-open' : ''}} {{item.done ? 'is-done' : ''}}"
      bindtap="onCheckin"
      data-type="{{item.key}}"
    >
      <view class="emoji-wrap {{item.key}}">{{item.emoji}}</view>
      <view class="card-main">
        <view class="card-title">{{item.label}}</view>
        <view class="card-meta">{{item.window}}</view>
        <view class="card-hint {{item.state}}">{{item.hint}}</view>
      </view>
      <view class="btn {{item.done ? 'is-done' : (item.canCheck ? '' : 'is-disabled')}}">{{item.done ? '已完成' : (item.canCheck ? '打卡' : '未开放')}}</view>
    </view>

    <!-- 当月日历：一行一个人（粉=我，蓝=TA） -->
    <view class="card cal-card">
      <view class="cal-head">
        <text class="cal-title">{{monthLabel}}</text>
        <view class="cal-legend">
          <view class="lg"><view class="bar me lv3"></view><text>我</text></view>
          <view class="lg"><view class="bar ta lv3"></view><text>TA</text></view>
        </view>
      </view>

      <view class="cal-week">
        <view class="cal-week-cell" wx:for="{{weekdays}}" wx:key="*this">{{item}}</view>
      </view>

      <view class="cal-grid">
        <view class="cal-cell" wx:for="{{cells}}" wx:key="id">
          <block wx:if="{{!item.blank}}">
            <view class="cal-day {{item.isToday ? 'is-today' : ''}}">{{item.day}}</view>
            <view class="bars">
              <view class="bar me lv{{item.meLevel}}"></view>
              <view class="bar ta lv{{item.taLevel}}"></view>
            </view>
          </block>
        </view>
      </view>

      <view class="cal-note">实心=打满且有爱心 · 半透=打满但有一项 0 分 · 细线=只打了一项 · 空白=没打</view>
    </view>

    <view class="safe-bottom"></view>
  </block>

  <view class="float-heart" wx:if="{{float}}">
    <view class="float-num">{{float}} ❤️</view>
    <view class="float-sub" wx:if="{{floatSub}}">{{floatSub}}</view>
  </view>

  <!-- 右上角 ⋯ 的菜单（自绘，不依赖系统弹窗） -->
  <view class="sheet-mask" wx:if="{{showMenu}}" bindtap="closeMenu"></view>
  <view class="sheet" wx:if="{{showMenu}}">
    <view class="sheet-title">打卡规则</view>
    <view class="sheet-item" bindtap="gotoRules" data-mode="view">
      <text class="sheet-emoji">📖</text>
      <view class="sheet-main">
        <text class="sheet-name">查看规则明细</text>
        <text class="sheet-desc">现在按什么时间窗口给分</text>
      </view>
    </view>
    <view class="sheet-item" bindtap="gotoRules" data-mode="edit">
      <text class="sheet-emoji">✏️</text>
      <view class="sheet-main">
        <text class="sheet-name">修改打卡规则</text>
        <text class="sheet-desc">要 TA 同意之后才生效</text>
      </view>
    </view>
    <view class="sheet-cancel" bindtap="closeMenu">取消</view>
  </view>
</view>
