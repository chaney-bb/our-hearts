<view class="page">

  <view class="loading" wx:if="{{!ready && !error}}">加载中…</view>
  <view class="err-banner" wx:if="{{error}}">{{error}}</view>

  <block wx:if="{{ready}}">

    <!-- 未登记 -->
    <view class="card gate" wx:if="{{needRegister}}">
      <view class="gate-emoji">📝</view>
      <view class="gate-title">还没登记</view>
      <view class="gate-desc">填完基本信息后才能收发爱心</view>
      <view class="btn gate-btn" bindtap="gotoRegister">去登记</view>
    </view>

    <block wx:else>

      <!-- 我 -->
      <view class="card me-card">
        <view class="me-av">{{me.avatarEmoji}}</view>
        <view class="me-main">
          <view class="me-name">{{me.displayName}}</view>
          <view class="me-sub" wx:if="{{bound}}">和 {{partner.displayName}} 在一起第 {{daysTogether}} 天</view>
          <view class="me-sub" wx:else>还没配对</view>
        </view>
        <view class="edit" bindtap="editProfile">修改</view>
      </view>

      <!-- 资料 -->
      <view class="card info-card">
        <view class="info-line">
          <text class="info-label">姓名</text>
          <text class="info-value">{{me.realName || '未填'}}</text>
        </view>
        <view class="info-line">
          <text class="info-label">手机号</text>
          <text class="info-value">{{me.phone || '未填'}}</text>
        </view>
        <view class="info-line">
          <text class="info-label">生日</text>
          <text class="info-value">{{me.birthday || '未填'}}</text>
        </view>
        <view class="info-line">
          <text class="info-label">性别</text>
          <text class="info-value">{{genderText}}</text>
        </view>
        <view class="info-line">
          <text class="info-label">自我介绍</text>
          <text class="info-value">{{me.bio || '还没写'}}</text>
        </view>
      </view>

      <!-- 对方 -->
      <view class="card partner-card" wx:if="{{bound}}">
        <view class="p-av">{{partner.avatarEmoji}}</view>
        <view class="p-main">
          <view class="p-name">{{partner.displayName}}</view>
          <view class="p-sub">{{partner.birthday || '生日未填'}} · {{partner.bio || '还没写自我介绍'}}</view>
        </view>
        <view class="p-tag">已配对</view>
      </view>

      <!-- 未配对：邀请码 -->
      <view class="card invite-card" wx:else>
        <view class="invite-title">我的邀请码</view>
        <view class="invite-row">
          <text class="code">{{inviteCode}}</text>
          <view class="btn-ghost" bindtap="copyCode">复制</view>
        </view>
        <view class="invite-note">发给 TA，让 TA 在首页输入就能配对</view>
      </view>

      <!-- 操作 -->
      <view class="actions">
        <view class="action" bindtap="editProfile">
          <text>修改资料</text><text class="arrow">›</text>
        </view>
        <view class="action" bindtap="verify">
          <text>爱心对账</text><text class="arrow">›</text>
        </view>
        <view class="action danger" wx:if="{{bound}}" bindtap="onUnbind">
          <text>解除绑定</text><text class="arrow">›</text>
        </view>
      </view>

      <view class="foot">
        <text>当前模式：{{mode === 'cloud' ? '云开发（两人共享）' : '本地预览（只存本机）'}}</text>
      </view>

    </block>

    <view class="safe-bottom"></view>
  </block>
</view>
