.topbar {
  padding: 0 40rpx 36rpx;
  background: linear-gradient(180deg, #FFEDF0 0%, #FFF7F3 100%);
}

.topbar-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.topbar-sub {
  font-size: 24rpx;
  color: #A08B87;
  margin-top: 6rpx;
}

.body {
  padding: 0 32rpx;
}

/* 概况 */
.stat-row {
  display: flex;
  margin-bottom: 22rpx;
}

.stat-card {
  flex: 1;
  margin-right: 18rpx;
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 26rpx 20rpx;
  text-align: center;
  box-shadow: 0 8rpx 26rpx rgba(255, 107, 129, 0.07);
}

.stat-num {
  font-size: 44rpx;
  font-weight: 700;
  color: #3A2A28;
  line-height: 1.2;
}

.stat-num.heart {
  color: #FF5C77;
}

.stat-label {
  font-size: 22rpx;
  color: #A08B87;
  margin-top: 6rpx;
}

.stat-card:last-child {
  margin-right: 0;
}

/* 日历 */
.cal-card {
  padding: 28rpx 22rpx 22rpx;
  margin-bottom: 22rpx;
}

.cal-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 8rpx 20rpx;
}

.cal-title {
  font-size: 28rpx;
  font-weight: 600;
}

.cal-nav {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFF0F3;
  color: #FF6B81;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  line-height: 1;
}

.cal-nav.is-off {
  background: #F7EFED;
  color: #D8C9C5;
}

.cal-week {
  display: flex;
  padding-bottom: 12rpx;
}

.cal-week-cell {
  width: 14.2857%;
  text-align: center;
  font-size: 22rpx;
  color: #B9A5A0;
}

.cal-grid {
  display: flex;
  flex-wrap: wrap;
}

.cal-cell {
  width: 14.2857%;
  height: 96rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.cell-day {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 26rpx;
  color: #4A3A38;
}

.cell-day.is-full {
  background: #FFE8EC;
  color: #FF5C77;
  font-weight: 700;
}

.cell-day.is-today {
  border: 3rpx solid #FF6B81;
  line-height: 46rpx;
}

.cell-dots {
  display: flex;
  margin-top: 4rpx;
  height: 12rpx;
}

.dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #F0E4E1;
  margin-right: 6rpx;
}

.dot:last-child {
  margin-right: 0;
}

.dot.sleep.on {
  background: #8B7BFF;
}

.dot.wake.on {
  background: #FFB84D;
}

.dot.is-full-legend {
  width: 22rpx;
  height: 22rpx;
  border-radius: 6rpx;
  background: #FFE8EC;
  border: 2rpx solid #FFC2CC;
}

.cal-legend {
  display: flex;
  align-items: center;
  padding: 18rpx 8rpx 4rpx;
  border-top: 2rpx solid #FDF1EE;
  margin-top: 14rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  margin-right: 32rpx;
  font-size: 22rpx;
  color: #A08B87;
}

.legend-item text {
  margin-left: 10rpx;
}

/* 明细 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 24rpx 8rpx 18rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
}

.log-card {
  padding: 8rpx 28rpx;
}

.log-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #FDF4F1;
}

.log-line:last-child {
  border-bottom: none;
}

.log-reason {
  font-size: 27rpx;
  font-weight: 500;
}

.log-time {
  font-size: 21rpx;
  color: #B9A5A0;
  margin-top: 4rpx;
}

.log-delta {
  font-size: 30rpx;
  font-weight: 700;
  color: #FF6B81;
}

.mock-tip {
  margin-top: 22rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FDF3EF;
  font-size: 22rpx;
  color: #B08A7E;
}
